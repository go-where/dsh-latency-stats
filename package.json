{
  "name": "dsh-latency-stats",
  "version": "0.2.5",
  "private": true,
  "description": "Model performance statistics for DeepSeek Harness: first-token latency, output speed and cache-hit rate per model, bucketed by hour of day.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node test/smoke.mjs",
    "test:e2e": "node test/e2e.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/go-where/dsh-latency-stats.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
